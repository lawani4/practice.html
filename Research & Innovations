    </div>

    <div class="quick-actions">
        <h2>Quick Actions</h2>
        <div class="actions-row">
            <div class="action-card">
                <div class="icon">🎓</div>
                <p>Staff Profiles</p>
            </div>
            <div class="action-card">
                <div class="icon">📖</div>
                <p>Publications</p>
            </div>
            <div class="action-card">
                <div class="icon">👥</div>
                <p>Research Centres</p>
            </div>
            <div class="action-card">
                <div class="icon"></div>
